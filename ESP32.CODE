/*
  SmartBin ESP32-S3 five-ultrasonic sensor test.
  This stage reports fill levels only. Servo control is intentionally excluded.

  Physical order: Sensor 1 is the right-most bin; Sensor 5 is the left-most bin.

  Important wiring change:
    Sensor 5 trigger must use GPIO7 because GPIO35 is input-only on ESP32-S3.
    Sensor 3 uses GPIO19/20, which may conflict with native USB on some boards.
*/

#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>
#include <ArduinoJson.h>

const char* WIFI_SSID = "AsusROG";
const char* WIFI_PASSWORD = "den200512";
const char* API_URL = "https://ct-abs.com/api/device.php?action=post_data";
const char* API_KEY = "d7a3537446863c4e3ad51ac53a34fb99447dfe83bb287a46";

// Sensor order is physical right-to-left and matches the five monitor positions.
// Sensor 1: right-most, Sensor 5: left-most.
const uint8_t TRIGGER_PINS[5] = {17, 11, 19, 48, 7};
const uint8_t ECHO_PINS[5] = {18, 10, 20, 47, 36};

// Calibrate these values for the actual bin geometry.
const float EMPTY_DISTANCE_CM = 40.0f;
const float FULL_DISTANCE_CM = 5.0f;
const unsigned long SEND_INTERVAL_MS = 30000;
const unsigned long SENSOR_TIMEOUT_US = 30000;

unsigned long lastSend = 0;

void connectWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to Wi-Fi");
  for (int attempt = 0; WiFi.status() != WL_CONNECTED && attempt < 30; attempt++) {
    delay(500);
    Serial.print('.');
  }
  Serial.println();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("Connected. IP: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("Wi-Fi connection failed.");
  }
}

float readDistanceCm(uint8_t triggerPin, uint8_t echoPin) {
  digitalWrite(triggerPin, LOW);
  delayMicroseconds(3);
  digitalWrite(triggerPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(triggerPin, LOW);

  unsigned long duration = pulseIn(echoPin, HIGH, SENSOR_TIMEOUT_US);
  if (duration == 0) return -1.0f;
  return (float)duration * 0.0343f / 2.0f;
}

float distanceToFill(float distanceCm) {
  if (distanceCm < 0) return 0.0f;
  float fill = (EMPTY_DISTANCE_CM - distanceCm) * 100.0f
      / (EMPTY_DISTANCE_CM - FULL_DISTANCE_CM);
  return constrain(fill, 0.0f, 100.0f);
}

void sendReadings() {
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
    if (WiFi.status() != WL_CONNECTED) return;
  }

  StaticJsonDocument<768> payload;
  JsonArray distances = payload.createNestedArray("ultrasonic_cm");
  JsonArray fills = payload.createNestedArray("fill_levels");

  for (int index = 0; index < 5; index++) {
    float distance = readDistanceCm(TRIGGER_PINS[index], ECHO_PINS[index]);
    float fill = distanceToFill(distance);
    distances.add(distance);
    fills.add(fill);
    Serial.printf("Sensor %d (%s): %.1f cm, %.1f%% full\n",
      index + 1, index == 0 ? "right-most" : index == 4 ? "left-most" : "middle",
      distance, fill);
    delay(60); // reduce cross-talk between ultrasonic sensors
  }

  payload["device_code"] = "ESP32_S3_5BIN_001";
  payload["timestamp_ms"] = millis();

  String body;
  serializeJson(payload, body);

  WiFiClientSecure client;
  client.setInsecure(); // Replace with certificate validation before production use.
  HTTPClient http;
  if (!http.begin(client, API_URL)) {
    Serial.println("Could not start HTTPS connection.");
    return;
  }
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-API-KEY", API_KEY);
  int responseCode = http.POST(body);
  Serial.printf("API response: %d\n", responseCode);
  Serial.println(http.getString());
  http.end();
}

void setup() {
  Serial.begin(115200);
  for (int index = 0; index < 5; index++) {
    pinMode(TRIGGER_PINS[index], OUTPUT);
    digitalWrite(TRIGGER_PINS[index], LOW);
    pinMode(ECHO_PINS[index], INPUT);
  }
  connectWiFi();
  sendReadings();
  lastSend = millis();
}

void loop() {
  if (millis() - lastSend >= SEND_INTERVAL_MS) {
    sendReadings();
    lastSend = millis();
  }
  delay(50);
}