/*
  ============================================================================
  SmartBin - ESP32 Firmware
  ----------------------------------------------------------------------------
  Peripherals:
    - 4x Ultrasonic (HC-SR04) for fill‑level monitoring
    - 4x Metal detector (digital output) – one per bin
    - 4x Servo (SG90/MG995) – controls bin flaps/doors
    - Wi‑Fi connection
    - HTTP communication with PHP API (JSON)

  Modes:
    - AUTO   : system classifies waste (based on sensor data) and routes it
               to the appropriate bin.
    - MANUAL : waits for remote command (which bin to open) from the API.

  The API endpoints (adjust to your server):
    - POST /api/sensors.php   -> sends ultrasonic levels & metal status
    - GET  /api/commands.php  -> retrieves mode and manual bin commands
  ============================================================================
*/

#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <Servo.h>

// -------------------- WiFi Credentials --------------------
const char* ssid = "YOUR_SSID";
const char* password = "YOUR_PASSWORD";

// -------------------- API Endpoints --------------------
const char* serverUrl = "http://your-server-ip/api";
const char* sensorEndpoint = "/sensors.php";
const char* commandEndpoint = "/commands.php";

// -------------------- Pin Definitions --------------------
// Ultrasonic sensors (TRIG, ECHO) for bins 1..4
#define TRIG1  14
#define ECHO1  27
#define TRIG2  12
#define ECHO2  26
#define TRIG3  13
#define ECHO3  25
#define TRIG4  15
#define ECHO4  33

// Metal detectors (digital input) for bins 1..4
#define METAL1  4
#define METAL2  5
#define METAL3  18
#define METAL4  19

// Servo control pins for bins 1..4
#define SERVO1  21
#define SERVO2  22
#define SERVO3  23
#define SERVO4  32

// -------------------- Global Objects --------------------
Servo servos[4];
int servoPins[4] = {SERVO1, SERVO2, SERVO3, SERVO4};

// Ultrasonic pin pairs
int trigPins[4] = {TRIG1, TRIG2, TRIG3, TRIG4};
int echoPins[4] = {ECHO1, ECHO2, ECHO3, ECHO4};

// Metal detector pins
int metalPins[4] = {METAL1, METAL2, METAL3, METAL4};

// -------------------- System State --------------------
enum Mode { AUTO, MANUAL };
Mode currentMode = AUTO;                // default: AUTO
int manualTargetBin = -1;               // -1 = no manual command
bool manualCommandPending = false;

// -------------------- Timing --------------------
unsigned long lastSensorSend = 0;
const unsigned long SENSOR_INTERVAL = 30000;  // send every 30 sec
unsigned long lastCommandCheck = 0;
const unsigned long COMMAND_INTERVAL = 5000;  // check commands every 5 sec

// -------------------- Function Prototypes --------------------
void connectWiFi();
float readUltrasonic(int trig, int echo);
bool readMetal(int pin);
void openBin(int binIndex);
void closeBin(int binIndex);
void closeAllBins();
void sendSensorData();
void checkCommands();
void classifyAndRoute();
void setMode(Mode mode);
void handleManualCommand(int bin);

// ============================================================================
//  SETUP
// ============================================================================
void setup() {
  Serial.begin(115200);
  Serial.println("\nSmartBin ESP32 starting...");

  // Initialize pins
  for (int i = 0; i < 4; i++) {
    pinMode(trigPins[i], OUTPUT);
    pinMode(echoPins[i], INPUT);
    pinMode(metalPins[i], INPUT_PULLUP);  // assume active LOW (metal detected -> LOW)
    servos[i].attach(servoPins[i]);
    servos[i].write(0);   // closed position (adjust according to your mechanism)
  }

  // Connect to Wi‑Fi
  connectWiFi();

  // Optionally send initial data
  sendSensorData();
}

// ============================================================================
//  MAIN LOOP
// ============================================================================
void loop() {
  // 1. Check Wi‑Fi connection, reconnect if lost
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }

  // 2. Periodic sensor data transmission
  if (millis() - lastSensorSend >= SENSOR_INTERVAL) {
    sendSensorData();
    lastSensorSend = millis();
  }

  // 3. Periodic command polling
  if (millis() - lastCommandCheck >= COMMAND_INTERVAL) {
    checkCommands();
    lastCommandCheck = millis();
  }

  // 4. AUTO mode: classify and route waste (triggered by some event?)
  //    For demonstration, we simulate a new waste item every 10 seconds.
  //    In real implementation, you would trigger this by a button or
  //    presence sensor at the input chute.
  static unsigned long lastClassification = 0;
  if (currentMode == AUTO && millis() - lastClassification >= 10000) {
    classifyAndRoute();
    lastClassification = millis();
  }

  // 5. MANUAL mode: execute pending command (if any)
  if (currentMode == MANUAL && manualCommandPending) {
    // Close all bins first, then open the target
    closeAllBins();
    if (manualTargetBin >= 0 && manualTargetBin < 4) {
      openBin(manualTargetBin);
      Serial.printf("Manual: opened bin %d\n", manualTargetBin);
    }
    manualCommandPending = false;
    manualTargetBin = -1;
  }

  // Small delay to prevent watchdog issues
  delay(100);
}

// ============================================================================
//  Wi‑Fi CONNECTION
// ============================================================================
void connectWiFi() {
  Serial.print("Connecting to Wi‑Fi");
  WiFi.begin(ssid, password);
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 20) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi‑Fi connected!");
    Serial.print("IP address: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nWi‑Fi connection failed! Will retry later.");
  }
}

// ============================================================================
//  ULTRASONIC READ (distance in cm)
// ============================================================================
float readUltrasonic(int trig, int echo) {
  digitalWrite(trig, LOW);
  delayMicroseconds(2);
  digitalWrite(trig, HIGH);
  delayMicroseconds(10);
  digitalWrite(trig, LOW);
  long duration = pulseIn(echo, HIGH, 30000);  // timeout 30ms
  if (duration == 0) return -1;  // no echo
  float distance = duration * 0.034 / 2;
  return distance;
}

// ============================================================================
//  METAL DETECTOR READ (true = metal detected)
// ============================================================================
bool readMetal(int pin) {
  // Assumes active LOW (digital read = LOW when metal present)
  return (digitalRead(pin) == LOW);
}

// ============================================================================
//  SERVO CONTROL
// ============================================================================
void openBin(int binIndex) {
  if (binIndex < 0 || binIndex >= 4) return;
  servos[binIndex].write(90);   // open position (adjust angle as needed)
}

void closeBin(int binIndex) {
  if (binIndex < 0 || binIndex >= 4) return;
  servos[binIndex].write(0);    // closed position
}

void closeAllBins() {
  for (int i = 0; i < 4; i++) {
    closeBin(i);
  }
}

// ============================================================================
//  WASTE CLASSIFICATION (AUTO mode)
//  Simulated logic: uses metal detectors and other sensors (if available).
//  For now, we just simulate with a pseudo‑random classification.
//  In practice, you would use AI camera, capacitive/inductive sensors.
// ============================================================================
int classifyWaste() {
  // Placeholder: read metal detectors on all bins? 
  // Actually classification should be done before routing.
  // Here we simulate: 0=biodegradable, 1=plastic, 2=metal, 3=other.
  // You can replace with real logic using sensors at the input.
  static int lastClass = 0;
  lastClass = (lastClass + 1) % 4;   // just cycle for demo
  return lastClass;
}

void classifyAndRoute() {
  if (currentMode != AUTO) return;

  // Close all bins first
  closeAllBins();
  delay(200);

  // Classify waste
  int bin = classifyWaste();   // returns 0..3
  Serial.printf("AUTO: classified as bin %d\n", bin);

  // Open the target bin
  openBin(bin);
  delay(3000);                 // keep open for waste to fall
  closeBin(bin);
}

// ============================================================================
//  SEND SENSOR DATA TO API
// ============================================================================
void sendSensorData() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected, cannot send data.");
    return;
  }

  HTTPClient http;
  String url = String(serverUrl) + String(sensorEndpoint);
  http.begin(url);
  http.addHeader("Content-Type", "application/json");

  // Build JSON payload
  StaticJsonDocument<512> doc;
  JsonArray ultrasonic = doc.createNestedArray("ultrasonic");
  JsonArray metal = doc.createNestedArray("metal");

  for (int i = 0; i < 4; i++) {
    float dist = readUltrasonic(trigPins[i], echoPins[i]);
    ultrasonic.add(dist);
    metal.add(readMetal(metalPins[i]));
  }

  // Add mode and timestamp
  doc["mode"] = (currentMode == AUTO) ? "AUTO" : "MANUAL";
  doc["timestamp"] = millis();

  String jsonStr;
  serializeJson(doc, jsonStr);

  Serial.print("Sending sensor data: ");
  Serial.println(jsonStr);

  int httpCode = http.POST(jsonStr);
  if (httpCode > 0) {
    String response = http.getString();
    Serial.printf("HTTP response code: %d\n", httpCode);
    Serial.println("Response: " + response);
  } else {
    Serial.printf("HTTP POST failed, error: %s\n", http.errorToString(httpCode).c_str());
  }
  http.end();
}

// ============================================================================
//  CHECK COMMANDS FROM API
// ============================================================================
void checkCommands() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected, cannot check commands.");
    return;
  }

  HTTPClient http;
  String url = String(serverUrl) + String(commandEndpoint);
  http.begin(url);
  http.addHeader("Content-Type", "application/json");

  // Optionally send device ID to get specific commands
  StaticJsonDocument<64> req;
  req["device"] = "ESP32_001";
  String reqStr;
  serializeJson(req, reqStr);

  int httpCode = http.POST(reqStr);   // or GET if your API expects GET
  if (httpCode == HTTP_CODE_OK) {
    String response = http.getString();
    Serial.println("Command response: " + response);

    // Parse JSON response
    StaticJsonDocument<256> doc;
    DeserializationError error = deserializeJson(doc, response);
    if (!error) {
      String mode = doc["mode"] | "AUTO";
      if (mode == "MANUAL") {
        setMode(MANUAL);
        int bin = doc["bin"] | -1;
        if (bin >= 0 && bin < 4) {
          manualTargetBin = bin;
          manualCommandPending = true;
        }
      } else {
        setMode(AUTO);
      }
    } else {
      Serial.println("Failed to parse command JSON");
    }
  } else {
    Serial.printf("Command check failed, HTTP code: %d\n", httpCode);
  }
  http.end();
}

// ============================================================================
//  MODE CONTROL
// ============================================================================
void setMode(Mode mode) {
  if (currentMode != mode) {
    currentMode = mode;
    Serial.printf("Mode changed to %s\n", (mode == AUTO) ? "AUTO" : "MANUAL");
    if (mode == AUTO) {
      // Close all bins when switching to AUTO
      closeAllBins();
      manualCommandPending = false;
    }
  }
}

// ============================================================================
//  (Optional) Handle manual command from local web interface or serial
// ============================================================================
void handleManualCommand(int bin) {
  if (currentMode == MANUAL && bin >= 0 && bin < 4) {
    closeAllBins();
    openBin(bin);
    Serial.printf("Manual command: opened bin %d\n", bin);
  }
}